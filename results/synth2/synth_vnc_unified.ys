# Phase II: single-bus system vnc_top, CACHE_EN = 1 (unified), U_LINES = 16 x 4 words, write buffer on,
# Xilinx 7-series. Run from the repository root:
#   yosys -l results/logs/synth2_vnc_unified.log results/synth2/synth_vnc_unified.ys
# main_mem is a black box, as for mh_top.
read_verilog rtl/mem/addr_decoder.v rtl/mem/cache.v rtl/mem/main_mem.v rtl/baseline/cpu_core_vn.v
read_verilog rtl/core/regfile.v rtl/core/alu.v rtl/core/imm_gen.v rtl/core/control.v
read_verilog rtl/common/perf_counters.v rtl/common/event_counters.v rtl/baseline/vnc_top.v
blackbox main_mem
chparam -set CACHE_EN 1 -set U_LINES 16 -set LINE_WORDS 4 -set WBUF 1 vnc_top
hierarchy -top vnc_top
proc
delete t:$meminit_v2 r:WORDS=1 %i
synth_xilinx -top vnc_top -family xc7 -flatten
tee -o results/synth2/vnc_unified_stat.txt stat
